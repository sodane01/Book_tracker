@model Book_tracker.ViewModels.BookDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="book-details-page">

    <a asp-controller="Discover"
       asp-action="Index"
       class="book-details-back">
        ← Back to Discover
    </a>

    <div class="book-details-layout">

        <div class="book-details-cover">

            @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl"
                     alt="Cover of @Model.Title" />
            }
            else
            {
                <div class="book-cover-placeholder">
                    <span aria-hidden="true">📖</span>
                    <span>No cover available</span>
                </div>
            }

        </div>

        <div class="book-details-content">

            <h1>
                @Model.Title
            </h1>

            @if (!string.IsNullOrWhiteSpace(Model.Author))
            {
                <p>
                    @Model.Author
                </p>
            }

            <div class="book-details-meta">

                @if (!string.IsNullOrWhiteSpace(Model.Publisher))
                {
                    <p>
                        <strong>Publisher:</strong>
                        @Model.Publisher
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.PublishedDate))
                {
                    <p>
                        <strong>Published:</strong>
                        @Model.PublishedDate
                    </p>
                }

                @if (Model.AverageRating.HasValue)
                {
                    <p class="book-details-rating">
                        <strong>Rating:</strong>
                        <span aria-hidden="true">★</span>
                        @Model.AverageRating.Value.ToString("0.0")
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <section class="book-details-description">

                        <h2>
                            About this book
                        </h2>

                        <p>
                            @System.Text.RegularExpressions.Regex.Replace(
                                System.Net.WebUtility.HtmlDecode(
                                    Model.Description),
                                "<.*?>",
                                string.Empty)
                        </p>

                    </section>
                }

            </div>

        </div>

    </div>

    @if (TempData["ReviewMessage"] is string reviewMessage)
    {
        <div class="alert alert-success mt-4">
            @reviewMessage
        </div>
    }

    @if (TempData["ReviewError"] is string reviewError)
    {
        <div class="alert alert-danger mt-4">
            @reviewError
        </div>
    }

    @if (User.Identity?.IsAuthenticated == true)
    {
        <section class="book-review-create mt-5">

            <h2 class="h4">
                Write a review
            </h2>

            <form asp-controller="Reviews"
                  asp-action="Create"
                  method="post">

                <input type="hidden"
                       name="externalBookId"
                       value="@Model.ExternalBookId" />

                <div class="mb-3">

                    <label for="reviewText"
                           class="form-label">
                        Your review
                    </label>

                    <textarea id="reviewText"
                              name="reviewText"
                              class="form-control"
                              rows="5"></textarea>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Add Review
                </button>

            </form>

        </section>
    }

    <section class="book-details-reviews mt-5">

        <h2>
            Reviews
        </h2>

        @if (Model.Reviews.Count == 0)
        {
            <div class="book-reviews-empty mt-3">

                <p class="text-muted">
                    No reviews yet.
                </p>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <p class="text-muted">
                        Be the first to review this book.
                    </p>
                }

            </div>
        }
        else
        {
            <div class="book-reviews-list mt-3">

                @foreach (var review in Model.Reviews)
                {
                    <article class="card mb-3">

                        <div class="card-body">

                            <div class="d-flex justify-content-between
                                        align-items-start gap-3">

                                <strong>
                                    @review.Username
                                </strong>

                                <small class="text-muted">
                                    @(review.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd"))
                                </small>

                            </div>

                            @if (review.IsOwnReview)
                            {
                                <form asp-controller="Reviews"
                                      asp-action="Edit"
                                      method="post"
                                      class="mt-3">

                                    <input type="hidden"
                                           name="reviewId"
                                           value="@review.Id" />

                                    <input type="hidden"
                                           name="externalBookId"
                                           value="@Model.ExternalBookId" />

                                    <div class="mb-2">

                                        <label for="reviewText-@review.Id"
                                               class="visually-hidden">
                                            Edit your review
                                        </label>

                                        <textarea id="reviewText-@review.Id"
                                                  name="reviewText"
                                                  class="form-control"
                                                  rows="4">@review.ReviewText</textarea>

                                    </div>

                                    <button type="submit"
                                            class="btn btn-primary btn-sm">
                                        Save Changes
                                    </button>

                                </form>

                                <form asp-controller="Reviews"
                                      asp-action="Delete"
                                      method="post"
                                      class="mt-2"
                                      onsubmit="return confirm('Delete this review?');">

                                    <input type="hidden"
                                           name="reviewId"
                                           value="@review.Id" />

                                    <input type="hidden"
                                           name="externalBookId"
                                           value="@Model.ExternalBookId" />

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm">
                                        Delete Review
                                    </button>

                                </form>
                            }
                            else
                            {
                                <p class="mt-3 mb-0">
                                    @review.ReviewText
                                </p>
                            }

                            @if (review.UpdatedAt.HasValue)
                            {
                                <small class="text-muted d-block mt-2">
                                    Edited
                                </small>
                            }

                        </div>

                    </article>
                }

            </div>
        }

    </section>

</div>
@model Book_tracker.ViewModels.BookDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="book-details-page cozy-book-details">

    <a asp-controller="Discover"
       asp-action="Index"
       class="book-details-back cozy-back-link">
        <span aria-hidden="true">←</span>
        Back to Discover
    </a>


    <!-- Book hero -->
    <section class="cozy-book-details-hero">

        <div class="book-details-cover cozy-details-cover">

            @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl"
                     alt="Cover of @Model.Title" />
            }
            else
            {
                <div class="book-cover-placeholder cozy-details-placeholder">

                    <span class="cozy-placeholder-star"
                          aria-hidden="true">
                        ★
                    </span>

                    <span>No cover available</span>

                </div>
            }

        </div>


        <div class="book-details-content cozy-details-content">

            <p class="home-eyebrow">
                <span aria-hidden="true">★</span>
                Book details
            </p>

            <h1>
                @Model.Title
            </h1>

            @if (!string.IsNullOrWhiteSpace(Model.Author))
            {
                <p class="cozy-details-author">
                    by @Model.Author
                </p>
            }


            <div class="cozy-details-meta">

                @if (!string.IsNullOrWhiteSpace(Model.Publisher))
                {
                    <div class="cozy-meta-item">

                        <span class="cozy-meta-label">
                            Publisher
                        </span>

                        <span class="cozy-meta-value">
                            @Model.Publisher
                        </span>

                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.PublishedDate))
                {
                    <div class="cozy-meta-item">

                        <span class="cozy-meta-label">
                            Published
                        </span>

                        <span class="cozy-meta-value">
                            @Model.PublishedDate
                        </span>

                    </div>
                }

                @if (Model.AverageRating.HasValue)
                {
                    <div class="cozy-meta-item cozy-meta-rating">

                        <span class="cozy-meta-label">
                            Reader rating
                        </span>

                        <span class="cozy-meta-value">

                            <span class="cozy-rating-star"
                                  aria-hidden="true">
                                ★
                            </span>

                            @Model.AverageRating.Value.ToString("0.0")

                        </span>

                    </div>
                }

            </div>


            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <section class="book-details-description cozy-details-description">

                    <p class="home-eyebrow">
                        About the story
                    </p>

                    <h2>
                        What's inside?
                    </h2>

                    <p>
                        @System.Text.RegularExpressions.Regex.Replace(
                            System.Net.WebUtility.HtmlDecode(
                                Model.Description),
                            "<.*?>",
                            string.Empty)
                    </p>

                </section>
            }

        </div>


        <span class="cozy-details-decoration cozy-details-star-one"
              aria-hidden="true">
            ★
        </span>

        <span class="cozy-details-decoration cozy-details-star-two"
              aria-hidden="true">
            ✦
        </span>

    </section>



    <!-- Review messages -->
    @if (TempData["ReviewMessage"] is string reviewMessage)
    {
        <div class="alert alert-success cozy-alert cozy-review-message"
             role="status">

            <span aria-hidden="true">
                ★
            </span>

            @reviewMessage

        </div>
    }

    @if (TempData["ReviewError"] is string reviewError)
    {
        <div class="alert alert-danger cozy-review-error"
             role="alert">

            <strong>
                Something went wrong.
            </strong>

            <span>
                @reviewError
            </span>

        </div>
    }



    <!-- Reviews area -->
    <section class="cozy-review-section">

        <header class="cozy-review-section-header">

            <div>

                <p class="home-eyebrow">
                    Reader notes
                </p>

                <h2>
                    Reviews
                </h2>

                <p>
                    Thoughts from readers who have spent a little time
                    between these pages.
                </p>

            </div>

            <span class="cozy-heading-star"
                  aria-hidden="true">
                ★
            </span>

        </header>


        @if (User.Identity?.IsAuthenticated == true)
        {
            <section class="book-review-create cozy-review-create">

                <div class="cozy-review-create-heading">

                    <div class="cozy-review-avatar"
                         aria-hidden="true">
                        ✎
                    </div>

                    <div>

                        <p class="home-eyebrow">
                            Your turn
                        </p>

                        <h3>
                            Write a review
                        </h3>

                        <p>
                            What did you think? Keep it short, write an essay,
                            or emotionally recover here in public.
                        </p>

                    </div>

                </div>


                <form asp-controller="Reviews"
                      asp-action="Create"
                      method="post">

                    <input type="hidden"
                           name="externalBookId"
                           value="@Model.ExternalBookId" />

                    <div class="mb-3">

                        <label for="reviewText"
                               class="form-label">
                            Your review
                        </label>

                        <textarea id="reviewText"
                                  name="reviewText"
                                  class="form-control cozy-review-textarea"
                                  rows="5"
                                  placeholder="So... how did this book make you feel?"></textarea>

                    </div>

                    <button type="submit"
                            class="btn btn-primary">
                        Add review
                    </button>

                </form>

            </section>
        }


        @if (Model.Reviews.Count == 0)
        {
            <div class="book-reviews-empty cozy-review-empty">

                <div class="cozy-empty-icon"
                     aria-hidden="true">
                    ☾
                </div>

                <div>

                    <h3>
                        No reader notes yet
                    </h3>

                    <p>
                        This corner of the library is still wonderfully quiet.
                    </p>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <p class="cozy-review-empty-extra">
                            Be the first to leave a review.
                        </p>
                    }

                </div>

            </div>
        }
        else
        {
            <div class="book-reviews-list cozy-review-list">

                @foreach (var review in Model.Reviews)
                {
                    <article class="cozy-review-card @(review.IsOwnReview ? "cozy-own-review" : "")">

                        <header class="cozy-review-card-header">

                            <div class="cozy-review-user">

                                <div class="cozy-review-avatar"
                                     aria-hidden="true">
                                    @(string.IsNullOrWhiteSpace(review.Username)
                                        ? "★"
                                        : review.Username.Substring(0, 1).ToUpper())
                                </div>

                                <div>

                                    <strong>
                                        @review.Username
                                    </strong>

                                    @if (review.IsOwnReview)
                                    {
                                        <span class="cozy-own-review-label">
                                            Your review
                                        </span>
                                    }

                                </div>

                            </div>


                            <div class="cozy-review-date">

                                <span>
                                    @review.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")
                                </span>

                                @if (review.UpdatedAt.HasValue)
                                {
                                    <span class="cozy-edited-label">
                                        Edited
                                    </span>
                                }

                            </div>

                        </header>


                        @if (review.IsOwnReview)
                        {
                            <form asp-controller="Reviews"
                                  asp-action="Edit"
                                  method="post"
                                  class="cozy-review-edit-form">

                                <input type="hidden"
                                       name="reviewId"
                                       value="@review.Id" />

                                <input type="hidden"
                                       name="externalBookId"
                                       value="@Model.ExternalBookId" />

                                <div>

                                    <label for="reviewText-@review.Id"
                                           class="visually-hidden">
                                        Edit your review
                                    </label>

                                    <textarea id="reviewText-@review.Id"
                                              name="reviewText"
                                              class="form-control cozy-review-textarea"
                                              rows="4">@review.ReviewText</textarea>

                                </div>

                                <div class="cozy-review-owner-actions">

                                    <button type="submit"
                                            class="btn btn-primary btn-sm">
                                        Save changes
                                    </button>

                                </div>

                            </form>


                            <form asp-controller="Reviews"
                                  asp-action="Delete"
                                  method="post"
                                  class="cozy-review-delete-form"
                                  onsubmit="return confirm('Delete this review?');">

                                <input type="hidden"
                                       name="reviewId"
                                       value="@review.Id" />

                                <input type="hidden"
                                       name="externalBookId"
                                       value="@Model.ExternalBookId" />

                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm">
                                    Delete review
                                </button>

                            </form>
                        }
                        else
                        {
                            <p class="cozy-review-text">
                                @review.ReviewText
                            </p>
                        }

                    </article>
                }

            </div>
        }

    </section>

</div>
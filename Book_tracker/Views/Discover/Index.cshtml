@using Book_tracker.Models.Enums
@model Book_tracker.ViewModels.DiscoverViewModel

@{
    ViewData["Title"] = "Discover";
}

<div class="discover-page cozy-discover">

    @if (TempData["ShelfMessage"] is string shelfMessage)
    {
        <div class="alert alert-success cozy-alert"
             role="status">
            <span aria-hidden="true">★</span>
            @shelfMessage
        </div>
    }

    <!-- Header -->
    <header class="cozy-discover-header">

        <div>
            <p class="home-eyebrow">
                <span aria-hidden="true">★</span>
                Explore the shelves
            </p>

            <h1>Discover your next read.</h1>

            <p class="discover-intro">
                Search by title, author, genre or series and see what catches
                your bookish little eye.
            </p>
        </div>

        <div class="discover-header-decoration"
             aria-hidden="true">
            <span class="discover-big-star">★</span>
            <span class="discover-small-star">✦</span>
        </div>

    </header>


    <!-- Search -->
    <section class="discover-search cozy-search-panel">

        <div class="cozy-search-heading">
            <span class="cozy-search-icon"
                  aria-hidden="true">
                ⌕
            </span>

            <div>
                <h2>Find a book</h2>
                <p>
                    A title you forgot, an author you love, or an entirely
                    unnecessary addition to your TBR pile.
                </p>
            </div>
        </div>

        <form asp-controller="Discover"
              asp-action="Index"
              method="get">

            <div class="discover-search-row">

                <div class="discover-search-type">

                    <label for="searchType"
                           class="form-label">
                        Search by
                    </label>

                    <select id="searchType"
                            name="searchType"
                            class="form-select">

                        @if (Model.SearchType == BookSearchType.Title)
                        {
                            <option value="Title" selected>
                                Title
                            </option>
                        }
                        else
                        {
                            <option value="Title">
                                Title
                            </option>
                        }

                        @if (Model.SearchType == BookSearchType.Author)
                        {
                            <option value="Author" selected>
                                Author
                            </option>
                        }
                        else
                        {
                            <option value="Author">
                                Author
                            </option>
                        }

                        @if (Model.SearchType == BookSearchType.Genre)
                        {
                            <option value="Genre" selected>
                                Genre
                            </option>
                        }
                        else
                        {
                            <option value="Genre">
                                Genre
                            </option>
                        }

                        @if (Model.SearchType == BookSearchType.Series)
                        {
                            <option value="Series" selected>
                                Series
                            </option>
                        }
                        else
                        {
                            <option value="Series">
                                Series
                            </option>
                        }

                    </select>

                </div>

                <div class="discover-search-query">

                    <label for="searchQuery"
                           class="form-label">
                        Search term
                    </label>

                    <input id="searchQuery"
                           name="searchQuery"
                           type="text"
                           class="form-control"
                           value="@Model.SearchQuery"
                           placeholder="What are we reading next?" />

                </div>

                <button type="submit"
                        class="btn btn-primary cozy-search-button">
                    Search
                </button>

            </div>

        </form>

    </section>


    <!-- Results -->
    <section class="discover-results cozy-discover-results">

        @if (!Model.HasSearched)
        {
            <div class="home-empty-state cozy-empty-state discover-empty-state">

                <div class="cozy-empty-icon"
                     aria-hidden="true">
                    ☾
                </div>

                <div>
                    <p class="home-eyebrow">
                        Your next favourite is out there
                    </p>

                    <h2>Search for your next book</h2>

                    <p>
                        Enter something above and start wandering through
                        the virtual bookshelves.
                    </p>
                </div>

            </div>
        }
        else if (Model.HasSearchError)
        {
            <div class="home-empty-state cozy-empty-state discover-empty-state"
                 role="alert">

                <div class="cozy-empty-icon"
                     aria-hidden="true">
                    !
                </div>

                <div>
                    <h2>The shelves are being difficult</h2>

                    <p>
                        We couldn't search for books right now.
                        Please try again.
                    </p>
                </div>

            </div>
        }
        else if (!Model.SearchResults.Any())
        {
            <div class="home-empty-state cozy-empty-state discover-empty-state">

                <div class="cozy-empty-icon"
                     aria-hidden="true">
                    ?
                </div>

                <div>
                    <h2>No books found</h2>

                    <p>
                        Apparently even the internet doesn't know that one.
                        Try another search term or search type.
                    </p>
                </div>

            </div>
        }
        else
        {
            <!-- Results heading + sort -->
            <div class="discover-results-toolbar">

                <div>
                    <p class="home-eyebrow">
                        Books found
                    </p>

                    <h2>Pick something wonderful.</h2>

                    <p>
                        Search results for
                        <strong>@Model.SearchQuery</strong>
                    </p>
                </div>


                <div class="discover-sort cozy-sort-panel">

                    <form asp-controller="Discover"
                          asp-action="Index"
                          method="get">

                        <input type="hidden"
                               name="searchQuery"
                               value="@Model.SearchQuery" />

                        <input type="hidden"
                               name="searchType"
                               value="@Model.SearchType" />

                        <label for="sortType"
                               class="form-label">
                            Sort by
                        </label>

                        <div class="discover-sort-row">

                            <select id="sortType"
                                    name="sortType"
                                    class="form-select">

                                @if (Model.SortType == BookSortType.Title)
                                {
                                    <option value="Title" selected>
                                        Title
                                    </option>
                                }
                                else
                                {
                                    <option value="Title">
                                        Title
                                    </option>
                                }

                                @if (Model.SortType == BookSortType.Author)
                                {
                                    <option value="Author" selected>
                                        Author
                                    </option>
                                }
                                else
                                {
                                    <option value="Author">
                                        Author
                                    </option>
                                }

                            </select>

                            <button type="submit"
                                    class="btn btn-outline-primary">
                                Sort
                            </button>

                        </div>

                    </form>

                </div>

            </div>


            <!-- Book cards -->
            <div class="discover-result-list cozy-book-results">

                @foreach (var book in Model.SearchResults)
                {
                    <article class="book-result-card cozy-book-card">

                        <div class="book-result-cover cozy-result-cover">

                            @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                            {
                                <img src="@book.CoverImageUrl"
                                     alt="Cover of @book.Title" />
                            }
                            else
                            {
                                <div class="book-cover-placeholder cozy-cover-placeholder">

                                    <span class="cozy-cover-star"
                                          aria-hidden="true">
                                        ★
                                    </span>

                                    <span>
                                        No cover available
                                    </span>

                                </div>
                            }

                        </div>


                        <div class="book-result-card-content cozy-result-content">

                            <div class="cozy-book-meta">

                                @if (book.AverageRating.HasValue)
                                {
                                    <span class="cozy-rating">

                                        <span aria-hidden="true">
                                            ★
                                        </span>

                                        @book.AverageRating.Value.ToString("0.0")

                                    </span>
                                }

                            </div>


                            <h2 class="book-result-title">
                                @book.Title
                            </h2>


                            @if (!string.IsNullOrWhiteSpace(book.Author))
                            {
                                <p class="book-result-author">
                                    by @book.Author
                                </p>
                            }


                            <div class="cozy-book-card-actions">

                                <a asp-controller="Book"
                                   asp-action="Details"
                                   asp-route-id="@book.ExternalBookId"
                                   class="btn btn-outline-primary book-result-details">

                                    View details

                                </a>


                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form asp-controller="Shelves"
                                          asp-action="Add"
                                          method="post"
                                          class="book-result-shelf cozy-shelf-form">

                                        <input type="hidden"
                                               name="ExternalBookId"
                                               value="@book.ExternalBookId" />

                                        <input type="hidden"
                                               name="SearchQuery"
                                               value="@Model.SearchQuery" />

                                        <input type="hidden"
                                               name="SearchType"
                                               value="@Model.SearchType" />

                                        <input type="hidden"
                                               name="SortType"
                                               value="@Model.SortType" />

                                        <label for="readingStatus-@book.ExternalBookId"
                                               class="form-label">
                                            Add to shelf
                                        </label>

                                        <select id="readingStatus-@book.ExternalBookId"
                                                name="ReadingStatus"
                                                class="form-select">

                                            <option value="WantToRead">
                                                Want to Read
                                            </option>

                                            <option value="CurrentlyReading">
                                                Currently Reading
                                            </option>

                                            <option value="Read">
                                                Read
                                            </option>

                                        </select>

                                        <button type="submit"
                                                class="btn btn-primary">
                                            Add to Shelf
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <div class="book-result-shelf cozy-guest-shelf">

                                        <button type="button"
                                                class="btn btn-primary guest-add-to-shelf"
                                                data-bs-toggle="modal"
                                                data-bs-target="#guestShelfModal">
                                            Add to Shelf
                                        </button>

                                    </div>
                                }

                            </div>

                        </div>

                    </article>
                }

            </div>
        }

    </section>

</div>


<!-- Guest Authentication Modal -->
@if (User.Identity?.IsAuthenticated != true)
{
    <div class="modal fade"
         id="guestShelfModal"
         tabindex="-1"
         aria-labelledby="guestShelfModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content cozy-modal">

                <div class="modal-header">

                    <div>
                        <p class="home-eyebrow">
                            Keep this one
                        </p>

                        <h2 class="modal-title fs-5"
                            id="guestShelfModalLabel">
                            Save books to your shelves
                        </h2>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <div class="modal-body">

                    <p class="mb-0">
                        Sign in or create your reading corner to start
                        building your personal shelves.
                    </p>

                </div>

                <div class="modal-footer">

                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       class="btn btn-primary">
                        Log in
                    </a>

                    <a asp-area="Identity"
                       asp-page="/Account/Register"
                       class="btn btn-outline-primary">
                        Create account
                    </a>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                </div>

            </div>

        </div>

    </div>
}
@using Book_tracker.Models.Enums
@model Book_tracker.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="profile-page cozy-profile">

    <!-- Header -->
    <header class="cozy-profile-header">

        <div>
            <p class="home-eyebrow">
                <span aria-hidden="true">★</span>
                Your reading corner
            </p>

            <h1>My Profile</h1>

            <p class="cozy-profile-intro">
                Your account, reading life and a few important
                bookish settings — all in one place.
            </p>
        </div>

        <div class="cozy-profile-header-mark"
             aria-hidden="true">
            <span>★</span>
            <span>✦</span>
        </div>

    </header>


    <!-- Messages -->
    @if (TempData["ProfileMessage"] != null)
    {
        <div class="alert alert-success cozy-alert"
             role="status">

            <span aria-hidden="true">★</span>

            @TempData["ProfileMessage"]

        </div>
    }

    @if (TempData["ProfileError"] != null)
    {
        <div class="alert alert-danger cozy-profile-error"
             role="alert">

            <strong>Something went wrong.</strong>

            <span>
                @TempData["ProfileError"]
            </span>

        </div>
    }


    <!-- Top row -->
    <div class="cozy-profile-top-grid">


        <!-- Reading Statistics -->
        <section class="cozy-profile-panel cozy-profile-stats">

            <header class="cozy-profile-panel-heading">

                <div>
                    <p class="home-eyebrow">
                        Your reading life
                    </p>

                    <h2>Reading Statistics</h2>
                </div>

                <span class="cozy-profile-panel-icon"
                      aria-hidden="true">
                    ☕
                </span>

            </header>


            <div class="cozy-profile-stat-grid">

                <div class="cozy-profile-stat">

                    <span class="cozy-profile-stat-value">
                        @Model.BooksRead
                    </span>

                    <span class="cozy-profile-stat-label">
                        Books Read
                    </span>

                </div>


                <div class="cozy-profile-stat">

                    <span class="cozy-profile-stat-value">
                        @Model.PagesRead
                    </span>

                    <span class="cozy-profile-stat-label">
                        Pages Read
                    </span>

                </div>

            </div>

        </section>


        <!-- Theme -->
        <section class="cozy-profile-panel cozy-profile-theme">

            <header class="cozy-profile-panel-heading">

                <div>
                    <p class="home-eyebrow">
                        Make it yours
                    </p>

                    <h2>Theme</h2>
                </div>

                <span class="cozy-profile-panel-icon"
                      aria-hidden="true">
                    ✦
                </span>

            </header>


            <p class="cozy-profile-helper">
                Choose between a warm little bookshop
                and Midnight Library™.
            </p>


            <form asp-action="UpdateTheme"
                  method="post">

                <fieldset>

                    <legend class="visually-hidden">
                        Theme
                    </legend>


                    <div class="cozy-theme-options">

                        <label class="cozy-theme-option">

                            <input class="form-check-input"
                                   type="radio"
                                   name="theme"
                                   value="@Theme.Light"
                                   checked="@(Model.Theme == Theme.Light)" />

                            <span class="cozy-theme-preview cozy-theme-preview-light"
                                  aria-hidden="true">

                                <span></span>
                                <span></span>
                                <span></span>

                            </span>

                            <span class="cozy-theme-copy">

                                <strong>
                                    Cozy Bookshop
                                </strong>

                                <small>
                                    Warm, soft and caffeinated.
                                </small>

                            </span>

                        </label>


                        <label class="cozy-theme-option">

                            <input class="form-check-input"
                                   type="radio"
                                   name="theme"
                                   value="@Theme.Dark"
                                   checked="@(Model.Theme == Theme.Dark)" />

                            <span class="cozy-theme-preview cozy-theme-preview-dark"
                                  aria-hidden="true">

                                <span></span>
                                <span></span>
                                <span></span>

                            </span>

                            <span class="cozy-theme-copy">

                                <strong>
                                    Midnight Library
                                </strong>

                                <small>
                                    For suspiciously late reading sessions.
                                </small>

                            </span>

                        </label>

                    </div>


                    <button type="submit"
                            class="btn btn-primary cozy-theme-save">
                        Save Theme
                    </button>

                </fieldset>

            </form>

        </section>

    </div>


    <!-- Main Profile Grid -->
    <div class="cozy-profile-main-grid">


        <!-- Account -->
        <section class="cozy-profile-panel">

            <header class="cozy-profile-panel-heading">

                <div>
                    <p class="home-eyebrow">
                        Account
                    </p>

                    <h2>Account Information</h2>
                </div>

                <span class="cozy-profile-panel-icon"
                      aria-hidden="true">
                    &#64;
                </span>

            </header>


            <form asp-action="UpdateAccount"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Username
                    </label>

                    <input class="form-control"
                           value="@Model.Username"
                           readonly />

                    <div class="form-text">
                        Username currently follows your email address.
                    </div>

                </div>


                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label">
                    </label>

                    <input asp-for="Email"
                           class="form-control" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

            </form>

        </section>


        <!-- Password -->
        <section class="cozy-profile-panel">

            <header class="cozy-profile-panel-heading">

                <div>
                    <p class="home-eyebrow">
                        Security
                    </p>

                    <h2>Change Password</h2>
                </div>

                <span class="cozy-profile-panel-icon"
                      aria-hidden="true">
                    •••
                </span>

            </header>


            <p class="cozy-profile-helper">
                Enter your current password and choose a new one.
            </p>


            <form asp-action="ChangePassword"
                  method="post">

                <div class="mb-3">

                    <label asp-for="CurrentPassword"
                           class="form-label">
                    </label>

                    <input asp-for="CurrentPassword"
                           class="form-control"
                           autocomplete="current-password" />

                    <span asp-validation-for="CurrentPassword"
                          class="text-danger">
                    </span>

                </div>


                <div class="cozy-password-row">

                    <div>

                        <label asp-for="NewPassword"
                               class="form-label">
                        </label>

                        <input asp-for="NewPassword"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="NewPassword"
                              class="text-danger">
                        </span>

                    </div>


                    <div>

                        <label asp-for="ConfirmPassword"
                               class="form-label">
                        </label>

                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <button type="submit"
                        class="btn btn-primary mt-3">
                    Change Password
                </button>

            </form>

        </section>

    </div>


    <!-- Favourite Books -->
    <section class="cozy-profile-panel cozy-profile-favourites">

        <header class="cozy-profile-panel-heading cozy-favourites-heading">

            <div>

                <p class="home-eyebrow">
                    <span aria-hidden="true">♥</span>
                    The chosen ones
                </p>

                <h2>Favourite Books</h2>

                <p class="cozy-profile-helper">
                    The books that earned permanent residence
                    in your tiny fictional hall of fame.
                </p>

            </div>


            <span class="cozy-favourite-count">
                @Model.FavouriteBooks.Count
                @(Model.FavouriteBooks.Count == 1 ? "favourite" : "favourites")
            </span>

        </header>


        @if (Model.FavouriteBooks.Count == 0)
        {
            <div class="cozy-profile-empty">

                <span aria-hidden="true">
                    ♡
                </span>

                <div>

                    <h3>
                        No favourites yet
                    </h3>

                    <p>
                        Apparently nobody has earned the heart yet.
                        The pressure is on.
                    </p>

                    <a asp-controller="Discover"
                       asp-action="Index">
                        Find something lovable →
                    </a>

                </div>

            </div>
        }
        else
        {
            <div class="cozy-profile-favourite-grid">

                @foreach (var book in Model.FavouriteBooks)
                {
                    <article class="cozy-profile-favourite-card">


                        <div class="cozy-profile-favourite-cover">

                            @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                            {
                                <img src="@book.CoverImageUrl"
                                     alt="Cover of @book.Title" />
                            }
                            else
                            {
                                <div class="cozy-profile-cover-placeholder">

                                    <span aria-hidden="true">
                                        ★
                                    </span>

                                    <small>
                                        No cover
                                    </small>

                                </div>
                            }


                            <span class="cozy-profile-heart"
                                  aria-hidden="true">
                                ♥
                            </span>

                        </div>


                        <div class="cozy-profile-favourite-content">

                            <div>

                                <h3>
                                    @book.Title
                                </h3>

                                @if (!string.IsNullOrWhiteSpace(book.Author))
                                {
                                    <p>
                                        @book.Author
                                    </p>
                                }

                            </div>


                            <div class="cozy-profile-favourite-actions">

                                <a asp-controller="Book"
                                   asp-action="Details"
                                   asp-route-id="@book.ExternalBookId"
                                   class="btn btn-sm btn-outline-primary">
                                    View Details
                                </a>


                                <form asp-controller="Profile"
                                      asp-action="ToggleFavourite"
                                      method="post">

                                    <input type="hidden"
                                           name="userBookId"
                                           value="@book.UserBookId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Remove Favourite
                                    </button>

                                </form>

                            </div>

                        </div>

                    </article>
                }

            </div>
        }

    </section>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
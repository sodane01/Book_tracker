@model Book_tracker.ViewModels.ShelvesViewModel

@{
    ViewData["Title"] = "My Shelves";
}

<div class="container py-4">

    <div class="mb-4">
        <h1>My Shelves</h1>

        <p class="text-muted">
            Keep track of the books you want to read,
            are currently reading, and have finished.
        </p>
    </div>

    @if (!Model.HasBooks)
    {
        <div class="home-empty-state mb-5">

            <h2>Your shelves are waiting for books</h2>

            <p>
                Discover books and add them to your shelves
                to start building your reading collection.
            </p>

            <a asp-controller="Discover"
               asp-action="Index"
               class="btn btn-primary">
                Discover Books
            </a>

        </div>
    }
    else
    {
        <!-- Want to Read -->
        <section class="mb-5"
                 aria-labelledby="want-to-read-heading">

            <h2 id="want-to-read-heading">
                Want to Read
            </h2>

            @if (Model.WantToReadBooks.Any())
            {
                <div class="row g-4 mt-1">

                    @foreach (var book in Model.WantToReadBooks)
                    {
                        <div class="col-12 col-md-6 col-xl-4">

                            <partial name="_ShelfBookCard"
                                     model="book" />

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="home-empty-state mt-3">

                    <p class="mb-0">
                        No books here yet.
                        Add a book from Discover to start your reading list.
                    </p>

                </div>
            }

        </section>

        <!-- Currently Reading -->
        <section class="mb-5"
                 aria-labelledby="currently-reading-heading">

            <h2 id="currently-reading-heading">
                Currently Reading
            </h2>

            @if (Model.CurrentlyReadingBooks.Any())
            {
                <div class="row g-4 mt-1">

                    @foreach (var book in Model.CurrentlyReadingBooks)
                    {
                        <div class="col-12 col-md-6 col-xl-4">

                            <partial name="_ShelfBookCard"
                                     model="book" />

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="home-empty-state mt-3">

                    <p class="mb-0">
                        No books here yet.
                        Move a book here when you start reading it.
                    </p>

                </div>
            }

        </section>

        <!-- Read -->
        <section class="mb-5"
                 aria-labelledby="read-heading">

            <h2 id="read-heading">
                Read
            </h2>

            @if (Model.ReadBooks.Any())
            {
                <div class="row g-4 mt-1">

                    @foreach (var book in Model.ReadBooks)
                    {
                        <div class="col-12 col-md-6 col-xl-4">

                            <partial name="_ShelfBookCard"
                                     model="book" />

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="home-empty-state mt-3">

                    <p class="mb-0">
                        No books here yet.
                        Books you finish will appear here.
                    </p>

                </div>
            }

        </section>
    }

</div>
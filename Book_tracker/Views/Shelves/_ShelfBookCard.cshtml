@using Book_tracker.Models.Enums
@model Book_tracker.ViewModels.ShelfBookViewModel

<article class="cozy-shelf-book-card @(Model.IsFavourite ? "is-favourite" : "")">

    <!-- Cover -->
    <div class="cozy-shelf-book-cover">

        @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
        {
            <img src="@Model.CoverImageUrl"
                 alt="Cover of @Model.Title" />
        }
        else
        {
            <div class="book-cover-placeholder cozy-shelf-cover-placeholder">

                <span class="cozy-cover-star"
                      aria-hidden="true">
                    ★
                </span>

                <span>
                    No cover available
                </span>

            </div>
        }


        @if (Model.IsFavourite)
        {
            <span class="cozy-favourite-badge"
                  aria-label="Favourite book">
                ♥
            </span>
        }

    </div>


    <!-- Book content -->
    <div class="cozy-shelf-book-content">

        <div class="cozy-shelf-book-heading">

            <h3>
                @Model.Title
            </h3>

            <p>
                @(string.IsNullOrWhiteSpace(Model.Author)
                    ? "Unknown author"
                    : Model.Author)
            </p>

        </div>


        <!-- Favourite -->
        <form asp-controller="Shelves"
              asp-action="ToggleFavourite"
              method="post"
              class="cozy-favourite-form">

            <input type="hidden"
                   name="userBookId"
                   value="@Model.UserBookId" />

            <button type="submit"
                    class="cozy-favourite-button @(Model.IsFavourite ? "active" : "")"
                    aria-pressed="@Model.IsFavourite.ToString().ToLower()">

                <span class="cozy-heart"
                      aria-hidden="true">
                    @(Model.IsFavourite ? "♥" : "♡")
                </span>

                <span>
                    @(Model.IsFavourite
                        ? "Favourite"
                        : "Add to favourites")
                </span>

            </button>

        </form>


        <!-- Reading status -->
        <form asp-controller="Shelves"
              asp-action="ChangeStatus"
              method="post"
              class="cozy-status-form">

            <input type="hidden"
                   name="userBookId"
                   value="@Model.UserBookId" />

            <label for="reading-status-@Model.UserBookId"
                   class="form-label">
                Reading status
            </label>

            <div class="cozy-status-controls">

                <select asp-for="ReadingStatus"
                        id="reading-status-@Model.UserBookId"
                        name="readingStatus"
                        class="form-select">

                    <option value="@ReadingStatus.WantToRead">
                        Want to Read
                    </option>

                    <option value="@ReadingStatus.CurrentlyReading">
                        Currently Reading
                    </option>

                    <option value="@ReadingStatus.Read">
                        Read
                    </option>

                </select>

                <button type="submit"
                        class="btn btn-primary btn-sm">
                    Update
                </button>

            </div>

        </form>


        <!-- Actions -->
        <div class="cozy-shelf-book-actions">

            <a asp-controller="Book"
               asp-action="Details"
               asp-route-id="@Model.ExternalBookId"
               class="btn btn-outline-primary">
                View details
            </a>


            <form asp-controller="Shelves"
                  asp-action="Remove"
                  method="post"
                  onsubmit="return confirm('Remove this book from your shelves?');">

                <input type="hidden"
                       name="userBookId"
                       value="@Model.UserBookId" />

                <button type="submit"
                        class="btn btn-outline-danger">
                    Remove
                </button>

            </form>

        </div>

    </div>

</article>
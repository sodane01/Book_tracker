@using Book_tracker.Models.Enums
@model Book_tracker.ViewModels.ShelfBookViewModel

<article class="book-result-card">

    <div class="book-result-cover">

        @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
        {
            <img src="@Model.CoverImageUrl"
                 alt="Cover of @Model.Title" />
        }
        else
        {
            <div class="book-cover-placeholder">

                <span aria-hidden="true">
                    📖
                </span>

                <span>
                    No cover available
                </span>

            </div>
        }

    </div>

    <div class="book-result-card-content">

        <h3 class="book-result-title">
            @Model.Title
        </h3>

        <p class="book-result-author">
            @(string.IsNullOrWhiteSpace(Model.Author)
                ? "Unknown author"
                : Model.Author)
        </p>

        <form asp-controller="Shelves"
              asp-action="ToggleFavourite"
              method="post"
              class="mt-3">

            <input type="hidden"
                   name="userBookId"
                   value="@Model.UserBookId" />

            <button type="submit"
                    class="btn @(Model.IsFavourite ? "btn-danger" : "btn-outline-danger")"
                    aria-pressed="@Model.IsFavourite.ToString().ToLower()">

                <span aria-hidden="true">
                    @(Model.IsFavourite ? "♥" : "♡")
                </span>

                @(Model.IsFavourite ? "Favourite" : "Add to favourites")

            </button>

        </form>

        <form asp-controller="Shelves"
              asp-action="ChangeStatus"
              method="post"
              class="mt-3">

            <input type="hidden"
                   name="userBookId"
                   value="@Model.UserBookId" />

            <label for="reading-status-@Model.UserBookId"
                   class="form-label">
                Reading status
            </label>

            <select asp-for="ReadingStatus"
                    id="reading-status-@Model.UserBookId"
                    name="readingStatus"
                    class="form-select">

                <option value="@ReadingStatus.WantToRead">
                    Want to Read
                </option>

                <option value="@ReadingStatus.CurrentlyReading">
                    Currently Reading
                </option>

                <option value="@ReadingStatus.Read">
                    Read
                </option>

            </select>

            <button type="submit"
                    class="btn btn-primary mt-2">
                Update status
            </button>

        </form>

        <div class="d-flex flex-wrap gap-2 mt-3">

            <a asp-controller="Book"
               asp-action="Details"
               asp-route-id="@Model.ExternalBookId"
               class="btn btn-outline-primary book-result-details">
                View details
            </a>

            <form asp-controller="Shelves"
                  asp-action="Remove"
                  method="post"
                  onsubmit="return confirm('Remove this book from your shelves?');">

                <input type="hidden"
                       name="userBookId"
                       value="@Model.UserBookId" />

                <button type="submit"
                        class="btn btn-outline-danger">
                    Remove
                </button>

            </form>

        </div>

    </div>

</article>